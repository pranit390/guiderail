---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroDemo from "../components/HeroDemo.astro";
import RailList from "../components/RailList.astro";
import FaqList from "../components/FaqList.astro";
import { content, nav, pageDescription, pageTitle } from "../content/guiderail";
---

<Base title={pageTitle} description={pageDescription}>
  <Header name={content.name} nav={nav} cta={content.cta} />
  <main id="top">
    <div class="wrap">
      <HeroDemo cta={content.cta} />
    </div>

    <section class="band" id={content.route.id} aria-labelledby="route-heading">
      <div class="wrap">
        <h2 id="route-heading">{content.route.heading}</h2>
        <p class="section-lede">{content.route.lede}</p>
        <RailList label={content.route.heading} stops={content.route.stops} />
      </div>
    </section>

    <section class="band" id={content.detour.id} aria-labelledby="detour-heading">
      <div class="wrap">
        <h2 id="detour-heading">{content.detour.heading}</h2>
        <p class="section-lede">{content.detour.lede}</p>
        <RailList label={content.detour.heading} stops={content.detour.stops} />
      </div>
    </section>

    <section class="band" id={content.faq.id} aria-labelledby="trust-heading">
      <div class="wrap">
        <h2 id="trust-heading">{content.faq.heading}</h2>
        <p class="section-lede">{content.faq.lede}</p>
        <FaqList items={content.faq.items} />
      </div>
    </section>

    <section class="band" aria-labelledby="close-heading">
      <div class="wrap close">
        <h2 id="close-heading">{content.close.heading}</h2>
        <p class="section-lede">{content.close.lede}</p>
        <div class="cta-row">
          <a class="button" href={content.cta.href} aria-describedby="cta-note">{content.cta.label}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer text={content.footer} />
</Base>
